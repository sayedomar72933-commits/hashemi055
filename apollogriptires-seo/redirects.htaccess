# BEGIN ApolloGrip legacy redirects
# Paste ABOVE the "# BEGIN WordPress" line in public_html/.htaccess.
# Use this OR the Yoast CSV import, not both.
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^about/?$ /about-us/ [R=301,L]
RewriteRule ^brampton/?$ /locations/brampton-location/ [R=301,L]
RewriteRule ^flat-tire-repair/?$ /services/flat-tire-repair/ [R=301,L]
RewriteRule ^(new|used)-tires-for-sale/?$ /services/tire-sales/ [R=301,L]
RewriteRule ^(mobile-tire-services|mobile-tire-service-areas|battery-boost)/?$ /services/mobile-tires-services/ [R=301,L]
RewriteRule ^(tire-services-in-toronto|tire-services-north-york|tire-services-etobicoke|tire-services-in-markham|tire-services-in-vaughan|tire-services-in-maple|mobile-tire-richmond-hill|tire-services-newmarket|tire-services-king-city|tire-services-in-oshawa|tire-services-in-whitby)/?$ /services/mobile-tires-services/ [R=301,L]
</IfModule>
# END ApolloGrip legacy redirects
